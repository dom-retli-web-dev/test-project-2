---
import { useTranslations, getLocaleUrl } from "@utils/i18n";

interface Props {
  locale: string;
  isHome?: boolean;
}

const { locale, isHome } = Astro.props as Props;
const t = useTranslations(locale);
---

<nav role="navigation" class="flex flex-col items-start gap-3 text-left text-sm md:w-auto">
  {
    !isHome && (
      <a class="unstyle-link group-hover:text-text-dark/60 hover:text-text-dark text-text-dark/80 w-fit" href={getLocaleUrl('/', locale)}>
        {t('nav.home')}
      </a>
    )
  }
  <a class="unstyle-link group-hover:text-text-dark/60 hover:text-text-dark text-text-dark/80 w-fit" href={getLocaleUrl('menu', locale)}>{t('nav.menu')}</a>
  <a class="unstyle-link group-hover:text-text-dark/60 hover:text-text-dark text-text-dark/80 w-fit" href={getLocaleUrl('about', locale)}>{t('nav.about')}</a>
</nav>