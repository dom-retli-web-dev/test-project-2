---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import Reveal from "@components/reveal.astro";
import { useTranslations, getLocaleUrl } from "@utils/i18n";
import { themeConfig } from "~/theme.config";


import loafSourdough from "@images/bread/hero-sourdough.jpg";
import loafCountry from "@images/bread/hero-country-loaf.jpg";
import loafBatard from "@images/bread/loaf-close-up.jpg";
import loafSeeded from "@images/bread/loaf-crust.jpg";

interface Props {
  locale?: string;
}

const { locale = themeConfig.i18n.defaultLocale } = Astro.props;
const t = useTranslations(locale);

interface BreadItem {
  image: ImageMetadata;
  alt: string;
  titleKey: string;
  textKey: string;
}

const loaves: BreadItem[] = [
  {
    image: loafSourdough,
    alt: "Classic sourdough boule on a wooden board, showing a golden crust and flour-dusted top",
    titleKey: "loaf-sourdough-title",
    textKey: "loaf-sourdough-text",
  },
  {
    image: loafCountry,
    alt: "Rustic country loaf with a hearty, flour-dusted crust on a linen cloth",
    titleKey: "loaf-country-title",
    textKey: "loaf-country-text",
  },
  {
    image: loafBatard,
    alt: "Artisan bâtard loaf with golden-brown crust and soft crumb visible at the cut",
    titleKey: "loaf-batard-title",
    textKey: "loaf-batard-text",
  },
  {
    image: loafSeeded,
    alt: "Seeded boule encrusted with sesame, sunflower, and pumpkin seeds",
    titleKey: "loaf-seeded-title",
    textKey: "loaf-seeded-text",
  },
];

interface Voice {
  slug: string;
  initials: string;
  tint: string;
}

const voices: Voice[] = [
  { slug: "voice-1", initials: "MV", tint: "from-primary to-secondary" },
  { slug: "voice-2", initials: "DP", tint: "from-primary-light to-primary-dark" },
  { slug: "voice-3", initials: "LR", tint: "from-secondary-light to-secondary" },
  { slug: "voice-4", initials: "TA", tint: "from-primary-dark to-primary-darker" },
];

interface UseCase {
  slug: string;
  icon: string;
}

const useCases: UseCase[] = [
  { slug: "usecase-weekend", icon: "heroicons:sun" },
  { slug: "usecase-gifts", icon: "heroicons:gift" },
  { slug: "usecase-table", icon: "heroicons:home" },
  { slug: "usecase-events", icon: "heroicons:calendar-days" },
];

const docsUrl = getLocaleUrl("docs", locale);
const featuresUrl = getLocaleUrl("features", locale);
---

<section class="home-content flex flex-col overflow-x-clip">
  <!-- ── Bread showcase ── -->
  <div class="graph-paper-bg-outer">
    <div class="container mx-auto py-20">
      <section aria-labelledby="home-loaves-heading">
        <Reveal class="mb-12 flex flex-col items-center gap-3 text-center">
          <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">
            {t('home-content.loaves-eyebrow')}
          </span>
          <h2 id="home-loaves-heading" class="text-3xl font-bold sm:text-4xl">
            {t('home-content.loaves-heading')}
          </h2>
          <p class="max-w-2xl text-stone-600 dark:text-stone-300">
            {t('home-content.loaves-sub')}
          </p>
        </Reveal>

        <ul class="m-0 grid list-none grid-cols-1 gap-6 p-0 sm:grid-cols-2 lg:grid-cols-4">
          {
            loaves.map((loaf, i) => (
              <Reveal as="li" delay={i * 70} from="up" class="m-0">
                <article class="loaf-card group relative flex h-full flex-col overflow-hidden rounded-xl border border-stone-300 bg-white transition-all hover:-translate-y-1 hover:shadow-xl dark:border-stone-700 dark:bg-stone-900">
                  <div class="aspect-[4/5] overflow-hidden">
                    <Image src={loaf.image} alt={loaf.alt} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" format="webp" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
                  </div>
                  <div class="flex flex-col gap-1.5 p-5">
                    <h3 class="text-lg font-bold">{t(`home-content.${loaf.titleKey}`)}</h3>
                    <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">{t(`home-content.${loaf.textKey}`)}</p>
                  </div>
                </article>
              </Reveal>
            ))
          }
        </ul>
      </section>
    </div>
  </div>

  <!-- ── Weekly Menu ── -->
  <div class="bg-white">
    <div class="container mx-auto py-20">
      <section aria-labelledby="home-menu-heading">
        <Reveal class="mb-12 flex flex-col items-center gap-3 text-center">
          <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">
            {t('home-content.menu-eyebrow')}
          </span>
          <h2 id="home-menu-heading" class="text-3xl font-bold sm:text-4xl">
            {t('home-content.menu-heading')}
          </h2>
          <p class="max-w-2xl text-stone-600 dark:text-stone-300">
            {t('home-content.menu-sub')}
          </p>
        </Reveal>

        <Reveal from="up" class="mx-auto flex max-w-4xl flex-col items-center gap-8 rounded-2xl border border-stone-200 bg-[#f5efe6] p-8 md:flex-row md:text-left">
          <div class="w-full shrink-0 md:w-64">
            <img src="/menu/weekly-preview.jpg" alt="This week's menu preview" class="w-full rounded-xl shadow-md" width="600" height="776" loading="eager" decoding="async" />
          </div>
          <div class="flex flex-col items-center gap-4 md:items-start">
            <p class="max-w-md text-sm leading-relaxed text-stone-600">
              {t('home-content.menu-note')}
            </p>
            <a href="/menu/weekly-menu.pdf" class="btn-primary group inline-flex w-fit items-center gap-2" target="_blank" rel="noopener">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
              {t('home-content.menu-cta')}
            </a>
          </div>
        </Reveal>
      </section>
    </div>
  </div>

  <!-- ── How it works ── -->
  <div class="bg-[#f5efe6]">
    <div class="container mx-auto py-20">
      <section aria-labelledby="home-howitworks-heading">
        <Reveal class="mb-14 flex flex-col items-center gap-3 text-center">
          <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">
            {t('home-content.howitworks-eyebrow')}
          </span>
          <h2 id="home-howitworks-heading" class="text-3xl font-bold sm:text-4xl">
            {t('home-content.howitworks-heading')}
          </h2>
          <p class="max-w-2xl text-stone-600 dark:text-stone-300">
            {t('home-content.howitworks-sub')}
          </p>
        </Reveal>

        <ol class="m-0 grid list-none grid-cols-1 gap-8 p-0 md:grid-cols-4">
          <li class="m-0 flex flex-col items-center text-center">
            <Reveal from="up" class="flex flex-col items-center gap-4">
              <span class="flex h-14 w-14 items-center justify-center rounded-full bg-primary text-xl font-bold text-white shadow-lg shadow-primary/20">1</span>
              <div class="flex flex-col gap-1.5">
                <h3 class="text-lg font-bold">{t('home-content.step-menu-title')}</h3>
                <p class="max-w-56 text-sm leading-relaxed text-stone-600 dark:text-stone-300">{t('home-content.step-menu-text')}</p>
              </div>
            </Reveal>
          </li>
          <li class="m-0 flex flex-col items-center text-center">
            <Reveal delay={70} from="up" class="flex flex-col items-center gap-4">
              <span class="flex h-14 w-14 items-center justify-center rounded-full bg-primary text-xl font-bold text-white shadow-lg shadow-primary/20">2</span>
              <div class="flex flex-col gap-1.5">
                <h3 class="text-lg font-bold">{t('home-content.step-signup-title')}</h3>
                <p class="max-w-56 text-sm leading-relaxed text-stone-600 dark:text-stone-300">{t('home-content.step-signup-text')}</p>
              </div>
            </Reveal>
          </li>
          <li class="m-0 flex flex-col items-center text-center">
            <Reveal delay={140} from="up" class="flex flex-col items-center gap-4">
              <span class="flex h-14 w-14 items-center justify-center rounded-full bg-primary text-xl font-bold text-white shadow-lg shadow-primary/20">3</span>
              <div class="flex flex-col gap-1.5">
                <h3 class="text-lg font-bold">{t('home-content.step-order-title')}</h3>
                <p class="max-w-56 text-sm leading-relaxed text-stone-600 dark:text-stone-300">{t('home-content.step-order-text')}</p>
              </div>
            </Reveal>
          </li>
          <li class="m-0 flex flex-col items-center text-center">
            <Reveal delay={210} from="up" class="flex flex-col items-center gap-4">
              <span class="flex h-14 w-14 items-center justify-center rounded-full bg-primary text-xl font-bold text-white shadow-lg shadow-primary/20">4</span>
              <div class="flex flex-col gap-1.5">
                <h3 class="text-lg font-bold">{t('home-content.step-pickup-title')}</h3>
                <p class="max-w-56 text-sm leading-relaxed text-stone-600 dark:text-stone-300">{t('home-content.step-pickup-text')}</p>
              </div>
            </Reveal>
          </li>
        </ol>
      </section>
    </div>
  </div>


  <!-- ── Use cases ── -->
  <div class="graph-paper-bg-inner">
    <div class="container mx-auto py-20">
      <section aria-labelledby="home-usecases-heading">
        <Reveal class="mb-12 flex flex-col items-center gap-3 text-center">
          <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">
            {t('home-content.usecases-eyebrow')}
          </span>
          <h2 id="home-usecases-heading" class="text-3xl font-bold sm:text-4xl">
            {t('home-content.usecases-heading')}
          </h2>
          <p class="max-w-2xl text-stone-600 dark:text-stone-300">
            {t('home-content.usecases-sub')}
          </p>
        </Reveal>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          {
            useCases.map((uc, i) => (
              <Reveal delay={i * 70} from={i % 2 === 0 ? 'left' : 'right'}>
                <article class="usecase-card group hover:border-primary dark:hover:border-primary-light flex h-full items-start gap-5 rounded-xl border border-stone-300 bg-white p-6 transition-all hover:shadow-lg dark:border-stone-700 dark:bg-stone-900">
                  <span class="bg-primary-light/15 text-primary dark:bg-primary-darker dark:text-primary-light flex h-12 w-12 shrink-0 items-center justify-center rounded-lg">
                    <Icon name={uc.icon} class="h-6 w-6" aria-hidden="true" />
                  </span>
                  <div class="flex flex-col gap-2">
                    <h3 class="text-lg font-bold">{t(`home-content.${uc.slug}-title`)}</h3>
                    <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">{t(`home-content.${uc.slug}-text`)}</p>
                  </div>
                </article>
              </Reveal>
            ))
          }
        </div>
      </section>
    </div>
  </div>


  <!-- ── Customer voices ── -->
  <div class="container mx-auto py-20">
    <section aria-labelledby="home-voices-heading">
      <Reveal class="mb-12 flex flex-col items-center gap-3 text-center">
        <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">
          {t('home-content.voices-eyebrow')}
        </span>
        <h2 id="home-voices-heading" class="text-3xl font-bold sm:text-4xl">
          {t('home-content.voices-heading')}
        </h2>
        <p class="max-w-2xl text-stone-600 dark:text-stone-300">
          {t('home-content.voices-sub')}
        </p>
      </Reveal>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          voices.map((voice, i) => (
            <Reveal delay={i * 70} from="up">
              <figure class="voice-card flex h-full flex-col gap-4 rounded-xl border border-stone-300 bg-white p-6 dark:border-stone-700 dark:bg-stone-900">
                <Icon name="heroicons:chat-bubble-left-right" class="h-6 w-6 text-stone-300 dark:text-stone-600" aria-hidden="true" />
                <blockquote class="grow text-sm leading-relaxed text-stone-700 dark:text-stone-200">"{t(`home-content.${voice.slug}-quote`)}"</blockquote>
                <figcaption class="flex items-center gap-3">
                  <span class={`flex h-10 w-10 items-center justify-center rounded-full bg-linear-to-br ${voice.tint} text-sm font-bold text-white`}>{voice.initials}</span>
                  <span class="flex flex-col">
                    <span class="text-sm font-semibold">{t(`home-content.${voice.slug}-name`)}</span>
                    <span class="text-xs text-stone-500 dark:text-stone-400">{t(`home-content.${voice.slug}-role`)}</span>
                  </span>
                </figcaption>
              </figure>
            </Reveal>
          ))
        }
      </div>
    </section>
  </div>

  <!-- ── CTA ── -->
  <div class="container mx-auto py-20">
    <div class="cta-band border-primary/20 from-primary-light/10 to-secondary-light/10 dark:from-primary-darker/30 dark:to-secondary-dark/20 relative overflow-hidden rounded-2xl border-4 bg-linear-to-br via-white px-6 py-12 text-center sm:px-12 dark:via-stone-900">
      <div class="cta-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative z-10 mx-auto flex max-w-2xl flex-col items-center gap-4">
        <h2 class="text-3xl font-bold sm:text-4xl">{t('home-content.cta-heading')}</h2>
        <p class="max-w-xl text-stone-600 dark:text-stone-300">
          {t('home-content.cta-sub')}
        </p>
        <div class="mt-2 flex flex-wrap items-center justify-center gap-4">
          <a href={docsUrl} class="btn-primary group">
            {t('home-content.cta-primary')}
            <Icon name="heroicons:arrow-right" class="mr-1 ml-0 h-4 w-4 transition-all duration-200 group-hover:mr-0 group-hover:ml-1" aria-hidden="true" />
          </a>
          <a href={featuresUrl} class="btn-subtle group rounded px-4 py-[0.43rem]">
            <span>{t('home-content.cta-secondary')}</span>
            <Icon name="heroicons:arrow-right" class="mr-1 ml-0 h-4 w-4 transition-all duration-200 group-hover:mr-0 group-hover:ml-1" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @reference "../../styles/tailwind.config.css";

  /* ── CTA glow ── */
  .cta-glow {
    background: radial-gradient(ellipse at 50% 0%, rgba(180, 131, 90, 0.18) 0%, transparent 60%);
  }
  :global(.dark) .cta-glow {
    background: radial-gradient(ellipse at 50% 0%, rgba(212, 165, 116, 0.16) 0%, transparent 60%);
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .cta-glow {
      animation: none;
    }
  }

  .graph-paper-bg-outer,
  .graph-paper-bg-inner {
    position: relative;
  }

  .graph-paper-bg-outer::before,
  .graph-paper-bg-inner::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: linear-gradient(rgba(212, 212, 212, 0.69) 2px, transparent 2px), linear-gradient(90deg, rgba(212, 212, 212, 0.69) 2px, transparent 2px), linear-gradient(rgba(212, 212, 212, 0.69) 1px, transparent 1px), linear-gradient(90deg, rgba(212, 212, 212, 0.69) 1px, rgba(247, 247, 252, 0) 1px);
    background-size:
      100px 100px,
      100px 100px,
      20px 20px,
      20px 20px;
    background-position:
      -2px -2px,
      -2px -2px,
      -1px -1px,
      -1px -1px;
  }

  /* In dark mode the light grid lines would be too bright, so dim them. */
  :global(.dark) .graph-paper-bg-outer::before,
  :global(.dark) .graph-paper-bg-inner::before {
    background-image: linear-gradient(rgba(80, 80, 80, 0.3) 2px, transparent 2px), linear-gradient(90deg, rgba(80, 80, 80, 0.3) 2px, transparent 2px), linear-gradient(rgba(80, 80, 80, 0.22) 1px, transparent 1px), linear-gradient(90deg, rgba(80, 80, 80, 0.22) 1px, rgba(247, 247, 252, 0) 1px);
  }

  .graph-paper-bg-outer::before {
    mask-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 0.6) 100%);
    -webkit-mask-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 0.6) 100%);
    mask-size: 100% 100%;
    -webkit-mask-size: 100% 100%;
    mask-repeat: no-repeat;
    -webkit-mask-repeat: no-repeat;
  }

  .graph-paper-bg-inner::before {
    mask-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0) 75%);
    -webkit-mask-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0) 75%);
    mask-size: 100% 100%;
    -webkit-mask-size: 100% 100%;
    mask-repeat: no-repeat;
    -webkit-mask-repeat: no-repeat;
  }

  .graph-paper-bg-outer > *,
  .graph-paper-bg-inner > * {
    position: relative;
    z-index: 1;
  }

  /* ── Parallax section ── */
  .parallax-section {
    position: relative;
    height: 200vh;
  }

  .parallax-section__pin {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .parallax-section__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .parallax-section__overlay {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .parallax-section__pin::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0.55));
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .parallax-section {
      height: auto;
    }
    .parallax-section__pin {
      position: relative;
      top: auto;
      height: 70vh;
    }
  }
</style>
