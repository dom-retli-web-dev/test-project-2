---
import Layout from "@layouts/default.astro";
import Headline from "@components/headline.astro";
import Reveal from "@components/reveal.astro";
import { Image } from "astro:assets";
import { useTranslations } from "@utils/i18n";
import { themeConfig } from '~/theme.config';

import BakerProfile from "@images/baker-profile.jpg";

const locale = themeConfig.i18n.defaultLocale;
const t = useTranslations(locale);
---

<Layout title={t('pages.about.title')} description={t('pages.about.description')}>
  <Headline text={t('pages.about.title')} class="pb-10" />

  <div class="container mx-auto pb-20">
    <Reveal from="up" class="mx-auto flex max-w-4xl flex-col items-center gap-10 md:flex-row md:items-start md:gap-12">
      <div class="w-full max-w-xs shrink-0 md:max-w-sm">
        <Image
          src={BakerProfile}
          alt="Portrait of the baker"
          format="webp"
          loading="eager"
          decoding="async"
          class="w-full rounded-3xl border-4 border-white/70 shadow-2xl"
        />
      </div>

      <div class="flex flex-col gap-5">
        <div class="flex flex-col gap-2">
          <h2 class="text-2xl font-bold">The Baker</h2>
          <p class="text-sm font-semibold tracking-wide text-stone-500 uppercase">Behind The Delighted Baker</p>
        </div>

        <p class="text-stone-700 dark:text-stone-300">
          [Placeholder] Hi, I'm the baker behind The Delighted Baker. I started baking sourdough at home as a quiet weekend ritual, and it slowly turned into something I couldn't stop sharing. Today I bake small batches in Michigan with patience, care, and a deep respect for good ingredients.
        </p>

        <p class="text-stone-700 dark:text-stone-300">
          [Placeholder] Everything in this bakery is naturally leavened and given the time it needs — no shortcuts, no rushing the dough. I love watching a simple mix of flour, water, and salt become a loaf with real character, and I love even more knowing it lands on your table.
        </p>

        <p class="text-stone-700 dark:text-stone-300">
          [Placeholder] Thank you for supporting small-batch baking. If you'd like to know what's fresh this week, take a look at the weekly menu — and if you have a question, I'm always happy to hear from you.
        </p>
      </div>
    </Reveal>
  </div>
</Layout>