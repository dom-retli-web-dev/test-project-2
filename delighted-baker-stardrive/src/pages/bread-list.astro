---
import Layout from "@layouts/default.astro";
import { env } from 'cloudflare:workers';
import { useTranslations } from "@utils/i18n";
import { themeConfig } from '~/theme.config';

export const prerender = false;

const locale = themeConfig.i18n.defaultLocale;
const t = useTranslations(locale);

interface BreadListEntry {
  name: string;
  phone: string;
  createdAt: string;
}

const token = new URL(Astro.request.url).searchParams.get('token') ?? '';
const secret = env.BREAD_LIST_TOKEN;

const authorized = secret !== undefined && token !== '' && token === secret;

let entries: BreadListEntry[] = [];

if (authorized && env.BREAD_LIST) {
  const kv = env.BREAD_LIST;
  const { keys } = await kv.list({ prefix: 'signup:', limit: 500 });
  const values = await Promise.all(
    keys.map(async (key) => kv.get<BreadListEntry>(key.name, 'json')),
  );
  entries = values
    .filter((entry): entry is BreadListEntry => entry !== null)
    .sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());
}

const formatPhone = (phone: string): string =>
  phone.length === 10 ? `(${phone.slice(0, 3)}) ${phone.slice(3, 6)}-${phone.slice(6)}` : phone;

const formatDate = (iso: string): string => {
  const date = new Date(iso);
  return `${date.toLocaleDateString('en-US')} · ${date.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' })}`;
};
---

<Layout title={t('pages.bread-list.title')} description={t('pages.bread-list.description')} robots={authorized ? themeConfig.robots : 'noindex, nofollow'}>
  {
    authorized ? (
      <div class="container mx-auto pb-20">
        <div class="mx-auto w-full max-w-3xl">
          <h1 class="mb-2 text-3xl font-bold">{t('pages.bread-list.heading')}</h1>
          <p class="mb-8 text-stone-600 dark:text-stone-300">
            {entries.length} {entries.length === 1 ? t('pages.bread-list.entry-singular') : t('pages.bread-list.entry-plural')}
          </p>

          {entries.length === 0 ? (
            <p class="rounded-xl border border-stone-300 bg-white p-8 text-center text-stone-500 dark:border-stone-700 dark:bg-stone-900">{t('pages.bread-list.empty')}</p>
          ) : (
            <ul class="m-0 flex list-none flex-col gap-3 p-0">
              {entries.map((entry) => (
                <li class="m-0 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-stone-300 bg-white p-5 dark:border-stone-700 dark:bg-stone-900">
                  <div class="flex flex-col gap-0.5">
                    <span class="font-semibold">{entry.name}</span>
                    <a href={`tel:${entry.phone}`} class="text-primary dark:text-primary-light w-fit no-underline">
                      {formatPhone(entry.phone)}
                    </a>
                  </div>
                  <span class="text-sm text-stone-500 dark:text-stone-400">{formatDate(entry.createdAt)}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    ) : (
      <div class="container mx-auto pb-20">
        <div class="mx-auto w-full max-w-md rounded-xl border border-stone-300 bg-white p-8 text-center dark:border-stone-700 dark:bg-stone-900">
          <h1 class="mb-3 text-2xl font-bold">{t('pages.bread-list.unauthorized-title')}</h1>
          <p class="text-stone-600 dark:text-stone-300">{t('pages.bread-list.unauthorized-text')}</p>
        </div>
      </div>
    )
  }
</Layout>
