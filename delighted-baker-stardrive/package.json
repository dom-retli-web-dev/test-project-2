{
  "name": "the-delighted-baker",
  "version": "1.0.0",
  "stardriveVersion": "1.4.2",
  "private": true,
  "description": "Artisan sourdough and seasonal bakes — a micro bakery website built with Astro Stardrive.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "postbuild": "scripts/postbuild.js",
    "purge:cloudflare": "node scripts/purgeCloudflareCache.js",
    "check": "npm run check:astro && npm run check:type && npm run check:eslint && npm run check:prettier",
    "check:astro": "astro check",
    "check:type": "npm run generate-types && tsc --noEmit",
    "check:eslint": "eslint .",
    "check:prettier": "prettier --check .",
    "fix": "npm run fix:eslint && npm run fix:prettier",
    "fix:eslint": "eslint --fix .",
    "fix:prettier": "prettier -w .",
    "generate-types": "wrangler types"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [
    "bakery",
    "sourdough",
    "artisan-bread",
    "astro",
    "website"
  ],
  "author": {
    "name": "The Delighted Baker",
    "url": ""
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "add-to-calendar-button": "^2.15.0",
    "astro": "^7.2.2",
    "astro-expressive-code": "^0.44.1",
    "astro-icon": "^1.1.5",
    "leaflet": "^1.9.4",
    "pmtiles": "^4.4.1",
    "protomaps-leaflet": "^5.1.0",
    "sanitize-html": "^2.17.6",
    "slot-text": "^0.3.3",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/ts-plugin": "^1.10.10",
    "@eslint/js": "^10.0.1",
    "@expressive-code/plugin-line-numbers": "^0.44.1",
    "@iconify-json/fa7-brands": "^1.2.4",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.91",
    "@types/hast": "^3.0.5",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.1.1",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/parser": "^8.65.0",
    "astro-compress": "^2.4.1",
    "astro-eslint-parser": "^3.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-regexp": "^3.1.1",
    "eslint-plugin-security": "^4.0.1",
    "fs-extra": "^11.3.6",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-string": "^4.0.0",
    "path": "^0.12.7",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "reading-time": "^1.5.0",
